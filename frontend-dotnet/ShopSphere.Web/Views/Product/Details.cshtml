@model ShopSphere.Web.Models.Product

<div class="container mt-5">

    <div class="row">

        <div class="col-md-5">

            <img src="https://placehold.co/600x500"
                 class="img-fluid rounded shadow"/>

        </div>

        <div class="col-md-7">

            <h2>@Model.Name</h2>

            <hr>

            <p>@Model.Description</p>

            <h3 class="text-success">$@Model.Price</h3>

            <p>
                Category:
                <strong>@Model.Category</strong>
            </p>

            <p>
                Stock:
                <strong>@Model.Stock</strong>
            </p>

            <button class="btn btn-primary btn-lg">
                Add to Cart
            </button>

        </div>

    </div>

</div>